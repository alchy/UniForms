# UniForms – example environment configuration
# Copy this file to .env and adjust the values before first run.

# ── JWT ───────────────────────────────────────────────────────────────────
# IMPORTANT: Set a strong random secret in production!
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-strong-random-key
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=480

# ── Cookie ────────────────────────────────────────────────────────────────
# Set to true in production behind HTTPS (marks the auth cookie Secure).
# COOKIE_SECURE=false

# ── Initial admin account ─────────────────────────────────────────────────
# Used only on first run when the database does not yet exist.
# Role assigned: system_admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── Auth provider ─────────────────────────────────────────────────────────
# Options: simple | access_manager | oauth | ldap   (default: simple)
# AUTH_PROVIDER=simple

# ── Paths (optional – can also be changed in the Settings UI) ─────────────
# DATABASE_PATH=data/uniforms.db
# DEFAULT_RECORDS_DIR=data/records
# DEFAULT_SCHEMAS_DIR=data/schemas
# DEFAULT_COLLECTIONS_DIR=data/collections

# ── access-manager – OTP login (github.com/alchy/access-manager) ──────────
# pip install -r requirements-access-manager.txt
# Login code = TOTP from the authenticator app. Role from realm groups:
#   ADMIN_GROUP (uniforms-admin) → system_admin, USER_GROUP (uniforms-user) → system_reader,
#   neither → refused. Group names follow the realm convention <app>-admin / <app>-user.
# A group member without a local account gets one on first login.
# AUTH_PROVIDER=simple          → local accounts keep passwords; accounts marked
#                                 "OTP" in Admin → Users and unknown names use access-manager
# AUTH_PROVIDER=access_manager  → every login goes through access-manager
# ACCESS_MANAGER_URL=https://auth.example.com
# ACCESS_MANAGER_KEY=am_k1_...          # issued in the access-manager console, never commit
# ACCESS_MANAGER_REALM=example.com      # assertion – mismatch with the key fails loudly
# ACCESS_MANAGER_HOME=                  # same-machine mode (no service) instead of URL+KEY
# ACCESS_MANAGER_CA=                    # custom CA bundle for the service certificate
# ACCESS_MANAGER_ADMIN_GROUP=uniforms-admin
# ACCESS_MANAGER_USER_GROUP=uniforms-user
